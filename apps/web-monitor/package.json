{
  "name": "web-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.mjs",
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src tests"
  },
  "dependencies": {
    "@go-tech/monitor-contract": "workspace:*"
  },
  "devDependencies": {
    "@go-tech/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:core",
    "vitest": "catalog:dev"
  }
}
