MONITOR_HOST=127.0.0.1
MONITOR_PORT=8200
# Generate separate service tokens, for example: openssl rand -hex 32
MONITOR_INGEST_TOKEN=
MONITOR_QUERY_TOKEN=
MONITOR_RETENTION_DAYS=7
MONITOR_MAX_REPORTS=10000

# Required: MySQL is the only storage. Use monitor_* tables in the existing go-tech database.
MONITOR_DATABASE_URL=
# Optional separate connection with DDL permissions for schema migrations.
# MONITOR_MIGRATION_DATABASE_URL=
# Generate with openssl rand -hex 32. Preserve the key for existing encrypted reports.
MONITOR_AUTH_ENCRYPTION_KEY=
MONITOR_AUTH_KEY_VERSION=v1
# Optional JSON map of previous key versions to 64-character hex keys.
# MONITOR_AUTH_PREVIOUS_KEYS={"v0":"<previous-key>"}
MONITOR_DB_POOL_SIZE=4
MONITOR_DB_QUEUE_LIMIT=32
MONITOR_DB_TIMEOUT_MS=5000
MONITOR_DB_PRUNE_BATCH=100
MONITOR_INGEST_CONCURRENCY=16
MONITOR_MAINTENANCE_MS=60000
# Tests/benchmark create and drop only their own temporary schemas.
# MONITOR_TEST_DATABASE_URL=mysql://test-user:test-password@127.0.0.1:3306/mysql
