  "c0c05496ee461b2994fbc97c19c02c979d8aeaab": {
    "source": "管理多個物業（住宅、商業或混合用途），需要追蹤不同物業的收入、支出和租賃狀況。",
    "translations": {
      "en-us": "Managing multiple properties (residential, commercial, or mixed-use) requires tracking the income, expenses, and leasing status of each property.",
      "zh-cn": "管理多个物业（住宅、商业或混合用途），需要追踪不同物业的收入、支出和租赁状况。",
      "zh-hk": "管理多個物業（住宅、商業或混合用途），需要追蹤不同物業的收入、支出和租賃狀況。"
    },
    "updatedAt": 1784687401565
  },
  "c2118186d1f4e2603031bec8f4110a9dfbd573bf": {
    "source": "專為物業集團設計的智能管理平臺，打通從決策到服務的全鏈條，讓數據驅動運營、系統賦能團隊，實現降本增效與品質提升的一體化管理。",
    "translations": {
      "en-us": "A smart management platform designed specifically for property management groups that integrates the entire chain from decision-making to service delivery, enabling data-driven operations and empowering teams through the system to achieve integrated management that reduces costs, improves efficiency, and enhances quality.",
      "zh-cn": "专为物业集团设计的智能管理平台，打通从决策到服务的全链条，让数据驱动运营、系统赋能团队，实现降本增效与品质提升的一体化管理。",
      "zh-hk": "專為物業集團設計的智能管理平台，打通從決策到服務的全鏈條，讓數據驅動運營、系統賦能團隊，實現降本增效與品質提升的一體化管理。"
    },
    "updatedAt": 1784687401565
  },
  "b839224e8728f60a9bebc15db40c0b4fa68f9145": {
    "source": "更標準，更高效的管理方式",
    "translations": {
      "en-us": "A more standardized and efficient management approach",
      "zh-cn": "更标准，更高效的管理方式",
      "zh-hk": "更標準，更高效的管理方式"
    },
    "updatedAt": 1784687401565
  },
  "8d7e6ef62a0fc27ee2c481c3b452e25dbe27bcb7": {
    "source": "業務流程更規範、更專業，讓租務管理有章可循、執行一致。",
    "translations": {
      "en-us": "More standardized and professional business processes ensure that rental management follows established guidelines and is carried out consistently.",
      "zh-cn": "业务流程更规范、更专业，让租务管理有章可循、执行一致。",
      "zh-hk": "業務流程更規範、更專業，讓租務管理有章可循、執行一致。"
    },
    "updatedAt": 1784687401565
  },
  "600e81ac9459eaac89d096f1a41a40f9fc65a4c0": {
    "source": "資訊集中與同步：所有物業、租約、收租、維修與文件資料統一管理，減少四處翻查與重複輸入。",
    "translations": {
      "en-us": "Centralized Information and Synchronization: Centralized management of all property, lease, rent collection, maintenance, and document information reduces the need to search through multiple sources and eliminates duplicate data entry.",
      "zh-cn": "资讯集中与同步：所有物业、租约、收租、维修与文件资料统一管理，减少四处翻查与重复输入。",
      "zh-hk": "資訊集中與同步：所有物業、租約、收租、維修與文件資料統一管理，減少四處翻查與重複輸入。"
    },
    "updatedAt": 1784687401565
  },
  "b2c605eab65abd54c150d6fc6c05ebff17e4c1a7": {
    "source": "多終端使用：支援電腦與手機等多裝置操作，隨時查看與跟進。",
    "translations": {
      "en-us": "Multi-device access: Supports use on multiple devices, such as computers and smartphones, so you can view and follow up on tasks at any time.",
      "zh-cn": "多终端使用：支援电脑与手机等多装置操作，随时查看与跟进。",
      "zh-hk": "多終端使用：支援電腦與手機等多裝置操作，隨時查看與跟進。"
    },
    "updatedAt": 1784687401565
  },
  "0b42cb8812f4e73d0379fa41e889d5431dc073f7": {
    "source": "節省人力成本：以清晰流程與集中管理減少人手投入，提升整體處理效率，讓租務管理更便捷、更高效。",
    "translations": {
      "en-us": "Reduce Labor Costs: By streamlining processes and centralizing management, we reduce the need for staff, improve overall processing efficiency, and make rental management more convenient and efficient.",
      "zh-cn": "节省人力成本：以清晰流程与集中管理减少人手投入，提升整体处理效率，让租务管理更便捷、更高效。",
      "zh-hk": "節省人力成本：以清晰流程與集中管理減少人手投入，提升整體處理效率，讓租務管理更便捷、更高效。"
    },
    "updatedAt": 1784687401565
  },
