# 会话秘钥
SESSION_SECRET=

# 服务端 Redis 连接地址（凭证不可使用 NEXT_PUBLIC_ 前缀）
REDIS_URL=redis://127.0.0.1:6379/0

# 系统默认语言
GO_TECH_LANGUAGE=

# 系统默认时区
GO_TECH_TIMEZONE=
# 服务端请求代理
API_INTERNAL_URL=
# 客户端请求代理
NEXT_PUBLIC_API_URL=
# pms后台地址
NEXT_PUBLIC_PMS_TRIAL_HOST=
# pms移动端地址
NEXT_PUBLIC_PMS_TRIAL_MOBILE_HOST=
# hr后台地址
NEXT_PUBLIC_HR_TRIAL_HOST=
# 控制 kpay 显示
NEXT_PUBLIC_KPAY_ENABLE=
# KPay 全托管收银台 Web 收银台地址
NEXT_PUBLIC_KPAY_CASHIER_URL=

# 日志服务资源token
NEXT_PUBLIC_BETTERSTACK_SOURCE_TOKEN=
# 日志服务报告地址
NEXT_PUBLIC_BETTERSTACK_INGEST_URL=

# alibaba | deepl | google | openai
TRANSLATION_PROVIDER=

# DeepL 翻译 API 密钥
DEEPL_API_KEY=

# Google Cloud Translation API 密钥
GOOGLE_TRANSLATE_API_KEY=

# 千问
QIANWEN_API_KEY=
QIANWEN_MODEL_NAME=

DATABASE_URL=

# 平台jwt密钥
PLATFORM_JWT_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# feedback-ai 认证秘钥
FEEDBACK_AI_INTERNAL_TOKEN=

# Browser errors, rrweb replay and Web Vitals (opt-in)
NEXT_PUBLIC_BROWSER_MONITOR_ENABLED=false
NEXT_PUBLIC_BROWSER_MONITOR_RELEASE=local
BROWSER_MONITOR_SERVICE_URL=http://127.0.0.1:8200
# Must match apps/web-monitor MONITOR_INGEST_TOKEN; never use a NEXT_PUBLIC prefix
BROWSER_MONITOR_INGEST_TOKEN=
# Server-side admin query credential, must match web-monitor MONITOR_QUERY_TOKEN
BROWSER_MONITOR_QUERY_TOKEN=
# Optional comma-separated public origins for proxies that do not preserve Host/protocol
BROWSER_MONITOR_ALLOWED_ORIGINS=
