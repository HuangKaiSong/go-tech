# Internal service authentication (must match apps/web-h5)
FEEDBACK_AI_INTERNAL_TOKEN=replace-with-a-long-random-token

# DeepSeek chat model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Source MySQL database
MYSQL_DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# PostgreSQL with the pgvector extension
POSTGRES_URL=postgresql://postgres:password@127.0.0.1:5432/aide

# OpenAI-compatible embedding provider
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_KNOWLEDGE_LIMIT=4
RAG_MEMORY_LIMIT=3
