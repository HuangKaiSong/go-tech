# DeepSeek chat model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Source MySQL database
MYSQL_DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# Local PostgreSQL with the pgvector extension installed
POSTGRES_URL=postgresql://postgres:password@127.0.0.1:5432/aide

# Embedding provider. DeepSeek does not expose an embeddings endpoint, so use
# OpenAI or another OpenAI-compatible embeddings service.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional retrieval and memory tuning
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_KNOWLEDGE_LIMIT=4
RAG_MEMORY_LIMIT=3
SHORT_TERM_MAX_TURNS=8
