{
  "name": "@go-tech/config",
  "version": "1.0.0",
  "private": true,
  "description": "Shared development configuration for go-tech",
  "author": {
    "name": "super_hks",
    "email": "3292339490@qq.com",
    "url": "https://github.com/HuangKaiSong"
  },
  "files": [
    "dist",
    "oxlint"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./vitest": {
      "types": "./src/vitest/index.ts",
      "default": "./dist/vitest/index.js"
    },
    "./oxlint/base.json": "./oxlint/base.json",
    "./oxlint/next.json": "./oxlint/next.json",
    "./oxlint/react.json": "./oxlint/react.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@go-tech/tsconfig": "workspace:*",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
