{
  "name": "@go-tech/ui-types",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Shared UI type definitions for cross-platform components",
  "keywords": [
    "cross-platform",
    "design-system",
    "react",
    "skyroc",
    "types",
    "typescript",
    "ui"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "clsx": "catalog:utils"
  },
  "devDependencies": {
    "@go-tech/tsconfig": "workspace:*",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
