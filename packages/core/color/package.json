{
  "name": "@go-tech/color",
  "version": "2.5.0",
  "type": "module",
  "description": "Color utilities and palette generation built on colord and culori, with Ant Design / OKLCH palettes",
  "keywords": [
    "antd",
    "color",
    "colord",
    "culori",
    "oklch",
    "palette",
    "react",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@go-tech/core-utils": "workspace:*",
    "colord": "2.9.3",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@go-tech/config": "workspace:*",
    "@go-tech/tsconfig": "workspace:*",
    "@types/culori": "^4.0.1",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
