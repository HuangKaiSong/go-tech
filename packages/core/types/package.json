  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@go-tech/tsconfig": "workspace:*",
    "typescript": "catalog:core"
  }
}
