{
  "name": "@go-tech/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared cross-app domain types (no runtime, no DOM)",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/index.d.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@go-tech/tsconfig": "workspace:*",
    "typescript": "catalog:core"
  }
}
