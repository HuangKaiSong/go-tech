{
  "name": "@go-tech/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared cross-app domain types (no runtime, no DOM)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
