{
  "name": "@go-tech/utils",
  "version": "2.0.2",
  "type": "module",
  "description": "Platform-agnostic utility functions with ./web subpath for browser-only utilities (download, window, BOM helpers)",
  "keywords": [
    "browser",
    "crypto",
    "date",
    "dayjs",
    "platform-agnostic",
    "react",
    "storage",
    "typescript",
    "utility"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "path": [
        "./src/path.ts"
      ],
      "web": [
        "./src/web/index.ts"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./path": "./src/path.ts",
    "./web": "./src/web/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@go-tech/type-utils": "workspace:*",
    "clsx": "catalog:utils",
    "colord": "catalog:utils",
    "crypto-js": "catalog:utils",
    "dayjs": "catalog:utils",
    "klona": "catalog:utils",
    "localforage": "catalog:utils",
    "nanoid": "catalog:utils",
    "radash": "^12.1.1",
    "tailwind-merge": "catalog:utils"
  },
  "devDependencies": {
    "@go-tech/config": "workspace:*",
    "@go-tech/tsconfig": "workspace:*",
    "@types/crypto-js": "catalog:dev",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
