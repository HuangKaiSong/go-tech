{
  "name": "@go-tech/core-utils",
  "version": "1.0.0",
  "private": true,
  "description": "Platform-agnostic utilities (no DOM, no framework)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "path": [
        "./src/path.ts"
      ],
      "web": [
        "./src/web/index.ts"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./path": "./src/path.ts",
    "./web": "./src/web/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "catalog:utils",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@go-tech/tsconfig": "workspace:*",
    "typescript": "catalog:core"
  }
}
