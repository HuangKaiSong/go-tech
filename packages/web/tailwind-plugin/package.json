{
  "name": "@go-tech/tailwind-plugin",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "Tailwind CSS plugin for Skyroc UI — OKLCH theme tokens, feedback colors, sidebar palette, and design-system presets",
  "keywords": [
    "design-system",
    "oklch",
    "skyroc",
    "tailwind",
    "tailwind-plugin",
    "tailwindcss",
    "theme",
    "ui-tokens"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@go-tech/color": "workspace:*",
    "@go-tech/ui-tokens": "workspace:*",
    "@unocss/core": "catalog:dev",
    "tailwindcss": "catalog:css"
  },
  "devDependencies": {
    "@go-tech/config": "workspace:*",
    "@go-tech/tsconfig": "workspace:*",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
